# Resend API Key (Get your key from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Recipient email where contact messages will be delivered
CONTACT_EMAIL_TO=fauzantaslim123@gmail.com

# Sender email address. Use "onboarding@resend.dev" for default testing without a custom domain,
# or your verified custom domain once added in Resend dashboard.
CONTACT_EMAIL_FROM="Portfolio Contact Form <onboarding@resend.dev>"

# Cloudflare Turnstile
# Client-side site key (use Cloudflare testing key "1x00000000000000000000BB" for invisible pass on localhost)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# Server-side secret key (use Cloudflare testing secret "1x0000000000000000000000000000000AA" for testing pass on localhost)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis (Optional in local dev - rate limiting fails open if not configured)
# Get from https://console.upstash.com or Vercel Marketplace
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

